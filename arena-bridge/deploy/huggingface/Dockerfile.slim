# Hugging Face Docker Space — ملف Space
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PORT=7860 \
    HOST=0.0.0.0

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY bridge.py .

EXPOSE 7860

CMD ["uvicorn", "bridge:app", "--host", "0.0.0.0", "--port", "7860"]
