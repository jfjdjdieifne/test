# انسخ هذا الملف إلى .env وعدّل القيم — لا تشارك .env أبداً
# انسخ:  cp .env.example .env

# المنفذ الذي سيشتغل عليه الجسر
HOST=0.0.0.0
PORT=8000

# مفتاح حماية الجسر (اختياري لكن يُنصح به بشدة إن كان على الإنترنت)
# جارفس سيرسله كـ Authorization: Bearer <هذا المفتاح>
BRIDGE_API_KEY=غيّرني-لعشوائية-طويلة

# النموذج الافتراضي (auto = اختيار Arena التلقائي، أو اسم نموذج محدد من /v1/models)
DEFAULT_MODEL=auto

# upstream اختياري: LMArenaBridge محلي (CloudWaddie/LMArenaBridge أو Blacklisted-Binary/LMArenaProxy)
# مثال: http://127.0.0.1:8001  (بدون /api/v1 في النهاية — الجسر يضيفها)
LMArenaBridge_URL=
LMArenaBridge_KEY=

# بديل ثالث: أي خدمة متوافقة مع OpenAI تعرف أنها تصل Arena (وسيط/جسر مستضاف تثق فيه)
OPENAI_COMPAT_URL=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=auto

# هل يتراجع gpt4free لمزودين مجانيين آخرين إذا فشل Arena؟ (true/false)
G4F_FALLBACK=true

# كوكيز Arena (اختياري — gpt4free قد يفتح متصفحاً بنفسه). لا تضعها هنا إن أمكن؛
# الأفضل تركها فارغة ودع gpt4free يدير الجلسة. إن احتجتها: الصق كوكيز arena-auth-prod-v1.
ARENA_COOKIES=
ARENA_COOKIES_FILE=
