{
  "name": "jarvis-24-7",
  "main": "agency/jarvis-stack/cf_worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./agency",
    "binding": "ASSETS",
    "run_worker_first": [
      "/telegram-webhook",
      "/health",
      "/setup",
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
