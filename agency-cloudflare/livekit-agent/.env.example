# انسخ الملف باسم .env أو صدّر المتغيرات بترمينالك — لا ترفع الحقيقي على git أبداً
# (placeholders فقط — القيم الحقيقية عندك ب Cloudflare [vars] ولوحة LiveKit)

# LiveKit Cloud — المشروع 1 (الأساسي)
LIVEKIT_URL=wss://your-project-1.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# مشروع LiveKit الثاني — اختياري (حصة مجانية مضاعفة). لتشغيل الـ Agent على المشروع الثاني:
# صدّر قيم الثاني بدل الثلاثة اللي فوق. التوكن بالصفحة /live يعرف تختار المشروع (1 أو 2).
# LIVEKIT_URL=wss://your-project-2.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Coarena — نفس المفتاح المضبوط ب Cloudflare تحت COARENA_API_KEY (أو /coarena key)
COARENA_API_KEY=coa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COARENA_MODEL=claude-fable-5-2

# Groq — مجاني من https://console.groq.com (بدون بطاقة) — لتحويل صوتك لنص
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# صوت إيدج المجاني — ar-SY-LaithNeural (شاركي رجل، الافتراضي) أو ar-SY-AmanyNeural (أنثى)
EDGE_TTS_VOICE=ar-SY-LaithNeural
