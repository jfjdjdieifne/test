# انسخ الملف باسم .env أو صدّر المتغيرات — لا ترفع الحقيقي على git أبداً
# القيم الحقيقية عندك ب Cloudflare [vars] ولوحة LiveKit/AWS

# LiveKit — المشروع 1 (الأساسي) — نفّذ الـ Agent على المشروع الجاي لو خلصت حصة 1
LIVEKIT_URL=wss://your-project-1.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# المشروع 2 (احتياط — حصة مضاعفة). لاستعماله للـ Agent: بدل الثلاثة فوق بقيم المشروع 2
# LIVEKIT_URL=wss://your-project-2.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
# LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Coarena — نفس COARENA_API_KEY ب [vars] (أو مفتاح من مجمعك، round-robin على الـ Worker)
COARENA_API_KEY=coa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COARENA_MODEL=claude-fable-5-2

# Groq — مجاني من https://console.groq.com (بدون بطاقة) — للتفريغ الصوتي
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TTS: edge (الافتراضي — شامي ar-SY-LaithNeural) أو polly (AWS Zayd/Hala neural ar-AE)
JARVIS_TTS=edge
EDGE_TTS_VOICE=ar-SY-LaithNeural
# للـ Polly: JARVIS_TTS=polly ثم:
# POLLY_VOICE=Zayd          # Zayd (ذكر ar-AE) · Hala (أنثى ar-AE) — لا يوجد صوت سوري بـ Polly
# AWS_REGION=us-east-2      # نفس منطقة حسابك AWS
# على EC2 استعمل IAM Role (AmazonPollyReadOnlyAccess) على الـ instance — بلا مفاتيح AWS بملفات.
# محلياً: export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (مستخدم IAM بصلاحية Polly فقط).
