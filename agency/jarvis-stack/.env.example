# --- 1) Telegram Bot (مجاني 100% من @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE
# مهم للأمان: ضع رقم حسابك من @userinfobot حتى لا يتحكم غيرك بالبوت
ALLOWED_TELEGRAM_ID=123456789

# --- 2) مفاتيح أقوى موديلات الذكاء المجانية (ضع واحداً أو كلّها للتناوب التلقائي بلا حدود تقريباً!) ---
# Google AI Studio (مجاني بدون بطاقة - Gemini 2.5 Flash / 2.5 Pro): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mistral AI (مجاني ~1 مليار توكن بالشهر! تحقق هاتف فقط - mistral-large-latest): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Groq (مجاني بدون بطاقة + Whisper مجاني للرسائل الصوتية): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM (مجاني بدون بطاقة - 100+ موديل ثقيل مثل Llama 3.3 / DeepSeek / Qwen): https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# OpenRouter Free Router (مجاني بدون بطاقة): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- 3) البحث بالإنترنت والصوت والرنين (اختياري ومجاني) ---
# Tavily (1,000 بحث مجاني/شهر بدون بطاقة) - إذا تركته فارغاً يستخدم DuckDuckGo مجاناً تلقائياً
TAVILY_API_KEY=

# الرد برسالة صوتية طبيعية داخل تيليجرام عبر edge-tts (تثبيت pip install edge-tts)
ENABLE_VOICE_REPLIES=true
ARABIC_VOICE=ar-AE-HamdanNeural
ENGLISH_VOICE=en-US-AndrewNeural

# لتفعيل أن يتصل بك جارفس ويرن جوالك عبر تيليجرام: أرسل /start إلى @CallMeBot_txtbot وضع @اسمك هنا
CALLMEBOT_TELEGRAM_USER=

# --- 4) حفظ الذاكرة والمهام سحابياً مجاناً (مهم عند النشر على Render Free حتى لا تضيع الذاكرة) ---
GITHUB_GIST_ID=
GITHUB_TOKEN=

# مسار ملف عملاء دبي (افتراضياً ../dubai_high_ticket_leads.csv)
LEADS_CSV_PATH=../dubai_high_ticket_leads.csv
