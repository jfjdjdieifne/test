# --- Telegram Bot (مجاني 100% عبر @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE
# مهم للأمان: ضع رقم Telegram ID الخاص بك (احصل عليه من @userinfobot)
# إذا تركته فارغاً سيقبل أوامر أي شخص - لا تتركه فارغاً!
ALLOWED_TELEGRAM_ID=123456789

# --- مزودو الذكاء الاصطناعي المجانيون (ضع واحد أو أكثر للتبديل التلقائي عند امتلاء الحد) ---
# 1. Google AI Studio (مجاني بدون بطاقة): https://aistudio.google.com/
GEMINI_API_KEY=
# 2. Groq (مجاني بدون بطاقة + Whisper مجاني للرسائل الصوتية): https://console.groq.com/
GROQ_API_KEY=
# 3. OpenRouter Free Router (مجاني بدون بطاقة): https://openrouter.ai/
OPENROUTER_API_KEY=

# --- الرد الصوتي والاتصال التنبيهي (اختياري ومجاني) ---
# تفعيل الرد برسالة صوتية عربية/إنجليزية طبيعية عبر edge-tts (true / false)
ENABLE_VOICE_REPLIES=true
ARABIC_VOICE=ar-AE-HamdanNeural
ENGLISH_VOICE=en-US-AndrewNeural

# لتفعيل أن يرن عليك جارفس بمكالمة تيليجرام عبر CallMeBot (مجاني للاستخدام الشخصي):
# فعّل البوت أولاً بإرسال /start إلى @CallMeBot_txtbot ثم ضع اسم المستخدم هنا مثل @yourname
CALLMEBOT_TELEGRAM_USER=

# مسار ملف عملاء دبي (اختياري - افتراضياً ../dubai_high_ticket_leads.csv)
LEADS_CSV_PATH=../dubai_high_ticket_leads.csv
